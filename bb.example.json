{
  "preflight": [
    "mdguard . --json",
    "graft . --check",
    "config-drift diff --configs-root ./configs --environments dev,staging,prod --fail-on-drift"
  ],
  "timeout_seconds": 120,
  "mockroute": {
    "config": "routes.json",
    "port": 8000
  },
  "commitlog": {
    "since": "last_tag",
    "format": "markdown"
  }
}
