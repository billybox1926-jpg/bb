{
  "preflight": [
    "mdguard check",
    "graft scan --json",
    "policy-runner run",
    "dep-health-scanner scan --json",
    "config-drift diff --fail-on-drift"
  ],
  "timeout_seconds": 120,
  "mockroute": {
    "config": "routes.json",
    "port": 8000
  },
  "commitlog": {
    "since": "last_tag",
    "format": "markdown"
  }
}
